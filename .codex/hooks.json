{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-codex-adapter.ts session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-codex-adapter.ts record-human-turn"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-codex-adapter.ts bind-bash-session"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-codex-adapter.ts deliver-stage-rules"
          }
        ],
        "matcher": "spawn_agent|collaborationspawn_agent"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-codex-adapter.ts state-transition-guard"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-codex-adapter.ts reviewer-scope"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-codex-adapter.ts review-freeze"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-codex-adapter.ts plan-approval-guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-codex-adapter.ts record-human-turn"
          }
        ],
        "matcher": "request_user_input"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-codex-adapter.ts audit-and-sensors"
          }
        ],
        "matcher": "apply_patch"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-codex-adapter.ts sync-workflow-state"
          }
        ],
        "matcher": "update_plan"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-codex-adapter.ts rebuild-stage-graph"
          }
        ],
        "matcher": "Bash"
      },
      {
        "matcher": "spawn_agent|collaborationspawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-codex-adapter.ts finish-stage-rules"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-codex-adapter.ts validate-state"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-codex-adapter.ts log-subagent"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-codex-adapter.ts continue-workflow"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-codex-adapter.ts start-stage-rules",
            "additionalContextLimit": 0
          }
        ]
      }
    ]
  }
}
